{
  "name": "ruta-rola-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:local": "ng serve --configuration local",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "android": "ng build && cap sync android",
    "android:abrir": "cap open android",
    "app:recursos": "node scripts/recursos-app.mjs && capacitor-assets generate --android --assetPath recursos-app --iconBackgroundColor '#111827' --iconBackgroundColorDark '#111827' --splashBackgroundColor '#111827' --splashBackgroundColorDark '#111827'"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@capacitor-community/background-geolocation": "1.3.1",
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@microsoft/signalr": "^8.0.7",
    "@tailwindcss/postcss": "^4.3.0",
    "apexcharts": "^5.14.0",
    "leaflet": "^1.9.4",
    "ng-apexcharts": "^2.4.0",
    "postcss": "^8.5.14",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.0",
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.2",
    "@types/leaflet": "^1.9.20",
    "daisyui": "^5.5.19",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
